# ---------------------------------------------------------------
# 复制为 .env.local 后填入真实值。.env* 已被 .gitignore 排除。
# 所有变量仅在服务端读取，切勿添加 NEXT_PUBLIC_ 前缀。
# ---------------------------------------------------------------

# OpenCode Go —— 仅在服务端调用，禁止添加 NEXT_PUBLIC_ 前缀
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.2
OPENCODE_GO_FALLBACK_MODEL=qwen3.5-plus
OPENCODE_GO_REQUEST_TIMEOUT_MS=40000
OPENCODE_GO_MAX_MODEL_CALLS=8
OPENCODE_GO_MAX_TOTAL_TOKENS=50000
# Sites 线上请求窗口约为 60 秒，预留时间给质量检查和数据库收尾。
OPENCODE_GO_MAX_DURATION_MS=48000

# 站点地址，用于生成分享链接
NEXT_PUBLIC_APP_URL=http://localhost:3000
