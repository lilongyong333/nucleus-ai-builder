# ---------------------------------------------------------------
# 复制为 .env.local 后填入真实值。.env* 已被 .gitignore 排除。
# 所有变量仅在服务端读取，切勿添加 NEXT_PUBLIC_ 前缀。
# ---------------------------------------------------------------

# OpenCode Go —— 仅在服务端调用，禁止添加 NEXT_PUBLIC_ 前缀
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=gpt-5.6-luna
OPENCODE_GO_FALLBACK_MODEL=glm-5.2
# 代码文件使用独立路由：GLM 的长代码协议稳定性更好，Luna 作为故障备用。
OPENCODE_GO_CODE_MODEL=glm-5.2
OPENCODE_GO_CODE_FALLBACK_MODEL=gpt-5.6-luna
# 每个 Agent 阶段独立请求；主模型最多 26 秒，始终给回退模型预留 18 秒。
OPENCODE_GO_REQUEST_TIMEOUT_MS=26000
OPENCODE_GO_FALLBACK_RESERVE_MS=18000
# 代码阶段给 GLM 更长主窗口，同时仍在单阶段截止时间内保留备用窗口。
OPENCODE_GO_CODE_REQUEST_TIMEOUT_MS=34000
OPENCODE_GO_CODE_FALLBACK_RESERVE_MS=16000
# 整个 Run 的硬上限；每次阶段开始都会读取已审计用量并扣减剩余额度。
OPENCODE_GO_MAX_MODEL_CALLS=24
OPENCODE_GO_MAX_TOTAL_TOKENS=180000
# 旧同步接口兼容的单请求时长预算（新分步接口不依赖一个长请求）。
OPENCODE_GO_MAX_DURATION_MS=48000
# 每个可恢复 Agent 阶段的独立预算。
OPENCODE_GO_STEP_MAX_CALLS=2
OPENCODE_GO_STEP_MAX_TOTAL_TOKENS=40000
OPENCODE_GO_STEP_MAX_DURATION_MS=52000
# 各工件最大输出额度；按文件职责分配，避免 HTML/CSS 额度反而诱发跨文件实现。
OPENCODE_GO_IRIS_MAX_TOKENS=6000
OPENCODE_GO_BOB_MAX_TOKENS=7000
OPENCODE_GO_HTML_MAX_TOKENS=4000
OPENCODE_GO_CSS_MAX_TOKENS=6000
OPENCODE_GO_JS_MAX_TOKENS=14000
OPENCODE_GO_RAY_MAX_TOKENS=8000
OPENCODE_GO_REPAIR_MAX_TOKENS=16000

# 站点地址，用于生成分享链接
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub Provider —— 服务端 Fine-grained PAT 或 GitHub App installation token。
# 至少需要目标仓库 Contents: write；触发 Actions 时还需要 Actions: write。
GITHUB_AUTOMATION_TOKEN=
# 执行 generated-app-eval.yml 的仓库，例如 owner/nucleus-ai-builder。
GITHUB_RUNNER_REPOSITORY=
GITHUB_RUNNER_REF=main
# 同时配置为 GitHub Actions 仓库 Secret；只用于 Runner 回调签名。
NUCLEUS_RUNNER_CALLBACK_TOKEN=

# 可选外部容器 Runner。当前 Sites Worker 本身不运行 Docker。
NUCLEUS_CONTAINER_RUNNER_URL=
NUCLEUS_CONTAINER_RUNNER_TOKEN=

# -----------------------------------------------------------------------------
# 每应用物理数据库 Provisioner（Cloudflare D1 REST API）
# Token 只需要 Account / D1 Edit；不要使用 Global API Key。
# 未配置时产品继续使用项目级逻辑隔离，并在控制面显示 configuration-required。
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_API_TOKEN=
# 可选：WNAM / ENAM / WEUR / EEUR / APAC / OC
NUCLEUS_D1_LOCATION_HINT=APAC

# -----------------------------------------------------------------------------
# GitHub App（推荐）；GITHUB_AUTOMATION_TOKEN 仅保留为兼容回退。
# GitHub App Setup URL: https://你的域名/api/github/app/setup
# GitHub App Callback URL: https://你的域名/api/github/app/callback
# 私钥换行可直接粘贴，也可以在托管平台使用 \n。
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# 运行 generated-app-eval.yml 的仓库对应 Installation ID。
GITHUB_RUNNER_INSTALLATION_ID=

# -----------------------------------------------------------------------------
# 邮件邀请（Resend）
# 发件地址必须属于已在 Resend 验证的域名。
# -----------------------------------------------------------------------------
RESEND_API_KEY=
NUCLEUS_EMAIL_FROM=Nucleus <invite@llynb.cc>

# -----------------------------------------------------------------------------
# Stripe 套餐、Checkout、Webhook、Billing Portal 与 Meter Event
# Webhook URL: https://你的域名/api/billing/webhook
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
STRIPE_METER_EVENT_NAME=nucleus_usage

# -----------------------------------------------------------------------------
# SLO、告警与定时维护
# 告警 Webhook 必须使用 HTTPS；也可只配置 SENTRY_DSN。
# -----------------------------------------------------------------------------
SENTRY_DSN=
NUCLEUS_ALERT_WEBHOOK_URL=
NUCLEUS_MAINTENANCE_TOKEN=

# 安全沙箱只允许固定 digest 的镜像，并限制在这里列出的 Registry。
NUCLEUS_ALLOWED_CONTAINER_REGISTRIES=docker.io,ghcr.io
