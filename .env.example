# ---------------------------------------------------------------
# 复制为 .env.local 后填入真实值。.env* 已被 .gitignore 排除。
# 所有变量仅在服务端读取，切勿添加 NEXT_PUBLIC_ 前缀。
# ---------------------------------------------------------------

# Claude API —— 生成与视觉评审
ANTHROPIC_API_KEY=

# Neon Postgres 连接串（Vercel 集成 Neon 后会自动注入）
DATABASE_URL=

# Auth.js 会话加密密钥：openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth（可选，游客模式不依赖）
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 站点地址，用于生成分享链接
NEXT_PUBLIC_APP_URL=http://localhost:3000
