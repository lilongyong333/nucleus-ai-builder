# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
/dist
/.vinext
/.wrangler

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但模板文件必须入库 —— 否则别人不知道要配哪些变量
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# 项目自定义
# ---------------------------------------------------------------

# 上游参考仓库的本地克隆（只用于阅读源码，绝不进版本控制）
/upstream/
/.upstream/

# 笔试原题与任何私有材料 —— 题目明确要求不得对外传播
*.pdf
/private/

# 运行期产物（预览截图、导出的 ZIP 等）
/tmp/
/.artifacts/
*.local.*

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
