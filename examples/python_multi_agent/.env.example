# 复制为 .env 后填写。这里只能放占位符，绝不能提交真实 Key。
CLOUD_API_BASE_URL=https://opencode.ai/zen/go/v1
CLOUD_API_KEY=replace_with_a_rotated_server_side_key

# API Key 负责认证；下面的 model 字段才负责选择模型。
CLOUD_DEFAULT_MODEL=replace_with_a_supported_general_model
PLANNER_MODEL=
ARCHITECT_MODEL=
# 下面留空会继承 CLOUD_DEFAULT_MODEL；确认网关模型名后再做角色路由。
CODER_MODEL=
REVIEWER_MODEL=

CLOUD_REQUEST_TIMEOUT_SECONDS=90
CLOUD_MAX_RETRIES=2
WORKFLOW_MAX_MODEL_CALLS=20
WORKFLOW_MAX_REPAIR_ROUNDS=2
